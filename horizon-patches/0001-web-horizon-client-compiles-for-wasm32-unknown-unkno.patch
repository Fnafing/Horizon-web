diff --git a/crates/horizon-client/src/game/event_loop.rs b/crates/horizon-client/src/game/event_loop.rs
index 0323997..5b69274 100644
--- a/crates/horizon-client/src/game/event_loop.rs
+++ b/crates/horizon-client/src/game/event_loop.rs
@@ -8,6 +8,33 @@
 use std::time::{Duration, Instant};
 use winit::event_loop::{ActiveEventLoop, ControlFlow};
 
+/// winit's clock: `web_time::Instant` in the browser, `std::time::Instant` elsewhere.
+#[cfg(target_arch = "wasm32")]
+pub(crate) type WinitInstant = web_time::Instant;
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) type WinitInstant = Instant;
+
+/// The game's `Instant` on winit's clock.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn to_winit(at: Instant) -> WinitInstant {
+    let (now, w) = (Instant::now(), web_time::Instant::now());
+    if at >= now { w + (at - now) } else { w.checked_sub(now - at).unwrap_or(w) }
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn to_winit(at: Instant) -> WinitInstant {
+    at
+}
+/// winit's `Instant` on the game's clock.
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn from_winit(at: WinitInstant) -> Instant {
+    let (now, w) = (Instant::now(), web_time::Instant::now());
+    if at >= w { now + (at - w) } else { now.checked_sub(w - at).unwrap_or(now) }
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn from_winit(at: WinitInstant) -> Instant {
+    at
+}
