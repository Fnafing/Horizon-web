+    pub fn new(_: Domain, _: Type, _: Option<Protocol>) -> io::Result<Socket> { no() }
+    pub fn bind(&self, _: &SockAddr) -> io::Result<()> { no() }
+    pub fn listen(&self, _: i32) -> io::Result<()> { no() }
