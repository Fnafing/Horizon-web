+            Self::MissingIndexData
+            | Self::InvalidVertexFormat(..)
+            | Self::TooManyGeometries(..)
+            | Self::TooManyPrimitives(..)
+            | Self::InvalidAabbStride(..) => ErrorType::Validation,
+        }
+    }
+}
