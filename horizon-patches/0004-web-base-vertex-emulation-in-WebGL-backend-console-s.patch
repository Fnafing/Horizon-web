+    fn label(&self) -> &str;
+
+    fn error_ident(&self) -> ResourceErrorIdent {
+        ResourceErrorIdent {
+            r#type: Cow::Borrowed(Self::TYPE),
+            label: self.label().to_owned(),
+        }
+    }
+}
