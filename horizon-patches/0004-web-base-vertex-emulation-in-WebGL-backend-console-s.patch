+
+        let hub = &self.hub;
+
+        let _bind_group = hub.bind_groups.remove(bind_group_id);
+
+        #[cfg(feature = "trace")]
+        if let Ok(bind_group) = _bind_group.get() {
+            if let Some(t) = bind_group.device.trace.lock().as_mut() {
+                t.add(trace::Action::DropBindGroup(bind_group.to_trace()));
+            }
+        }
+    }
