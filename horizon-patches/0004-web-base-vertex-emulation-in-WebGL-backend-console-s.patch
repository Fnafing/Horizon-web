+impl Trace for MemoryTrace {
+    /// Store `[u8]` data in the trace.
+    ///
+    /// Using a string `kind` is probably a bug, but should work as long as the
+    /// data is UTF-8.
+    fn make_binary(&mut self, kind: DataKind, data: &[u8]) -> Data {
