+#[cfg(send_sync)]
+pub type SubmittedWorkDoneClosure = Box<dyn FnOnce() + Send + 'static>;
+#[cfg(not(send_sync))]
+pub type SubmittedWorkDoneClosure = Box<dyn FnOnce() + 'static>;
