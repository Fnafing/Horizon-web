+    }
+
+    pub fn limits(&self) -> wgt::Limits {
+        self.raw.capabilities.limits.clone()
+    }
+
+    pub fn downlevel_capabilities(&self) -> wgt::DownlevelCapabilities {
+        self.raw.capabilities.downlevel.clone()
+    }
