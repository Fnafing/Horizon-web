+#!/usr/bin/env python3
+"""Patch the nightly toolchain's rust-src so wasm32-unknown-unknown std gets Horizon web's
+fs (in-memory VFS), time (performance.now/Date.now) and threads (Web Workers).
+Idempotent. Usage: python3 web/std/apply.py [SYSROOT]   (default: rustc +nightly --print sysroot)"""
+import os, subprocess, sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sysroot = sys.argv[1] if len(sys.argv) > 1 else subprocess.check_output(
+    ["rustc", "+nightly", "--print", "sysroot"], text=True).strip()
+STD = os.path.join(sysroot, "lib/rustlib/src/rust/library/std/src")
+WEB = 'all(target_family = "wasm", target_os = "unknown")'
+MARK = "// hzweb-patched"
+
+
+def rd(p):
+    return open(os.path.join(STD, p)).read()
+
+
+def wr(p, s):
+    open(os.path.join(STD, p), "w").write(s)
+
+
+def copy(src, dst):
+    wr(dst, open(os.path.join(HERE, src)).read())
+
+
+def patch(path, old, new):
+    s = rd(path)
+    if MARK in s:
+        return
+    assert s.count(old) == 1, f"{path}: anchor not found once: {old!r}"
+    wr(path, MARK + "\n" + s.replace(old, new))
+
+
+copy("fs_hzweb.rs", "sys/fs/hzweb.rs")
+copy("time_hzweb.rs", "sys/time/hzweb.rs")
+copy("thread_hzweb.rs", "sys/thread/hzweb.rs")
+copy("os_hzweb.rs", "os/hzweb.rs")
+
+# fs: our module before the catch-all, plus the hooks std::os::hzweb calls.
+patch("sys/fs/mod.rs", "    _ => {\n        mod unsupported;\n        use unsupported as imp;\n    }\n}",
+      f"    {WEB} => {{\n        mod hzweb;\n        use hzweb as imp;\n        pub(crate) mod hzweb_hooks {{\n"
+      "            pub use super::hzweb::{vfs_file_count, vfs_mkdirs, vfs_put, vfs_take_change};\n        }\n    }\n"
+      "    _ => {\n        mod unsupported;\n        use unsupported as imp;\n    }\n}")
+
+# time: same, before the catch-all.
+patch("sys/time/mod.rs", "    _ => {\n        mod unsupported;\n        use unsupported as imp;\n    }",
+      f"    {WEB} => {{\n        mod hzweb;\n        use hzweb as imp;\n    }}\n"
+      "    _ => {\n        mod unsupported;\n        use unsupported as imp;\n    }")
+
+# thread: our arm ahead of the generic wasm+atomics one.
+patch("sys/thread/mod.rs", '    all(target_family = "wasm", target_feature = "atomics") => {',
+      f'    all({WEB[4:-1]}, target_feature = "atomics") => {{\n'
+      "        mod hzweb;\n"
+      "        pub use hzweb::{DEFAULT_MIN_STACK_SIZE, Thread, available_parallelism, current_os_id, set_name, sleep, yield_now};\n"
+      "        pub(crate) use hzweb::{is_main as hzweb_is_main, thread_start as hzweb_thread_start};\n"
+      "    }\n"
+      '    all(target_family = "wasm", target_feature = "atomics") => {')
+
+# futex: the browser's main thread may not block; spin there instead.
+patch("sys/sync/futex/wasm.rs",
+      "pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {\n",
+      "pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {\n"
+      '    #[cfg(target_os = "unknown")]\n'
+      "    if crate::sys::thread::hzweb_is_main() {\n"
+      "        use crate::sync::atomic::Ordering;\n"
+      "        let end = timeout.map(|t| crate::time::Instant::now() + t);\n"
+      "        while futex.load(Ordering::Acquire) == expected {\n"
+      "            if end.is_some_and(|e| crate::time::Instant::now() >= e) {\n"
+      "                return false;\n"
+      "            }\n"
+      "            crate::hint::spin_loop();\n"
+      "        }\n"
+      "        return true;\n"
+      "    }\n")
+
+# threads wait on the futex directly.
+patch("sys/sync/mod.rs", "mod futex;\n", "pub(crate) mod futex;\n")
+
+# std::os::hzweb
+patch("os/mod.rs", "pub mod raw;",
+      "pub mod raw;\n\n"
+      f"#[cfg({WEB})]\n"
+      '#[unstable(feature = "hzweb", issue = "none")]\n'
+      "pub mod hzweb;")
+
+print("std patched for hzweb:", STD)
diff --git a/web/std/fs_hzweb.rs b/web/std/fs_hzweb.rs
new file mode 100644
index 0000000..7093388
--- /dev/null
+++ b/web/std/fs_hzweb.rs
@@ -0,0 +1,730 @@
+//! Horizon web: std::fs over an in-memory filesystem that lives in wasm memory, so every
+//! thread (Web Worker on the shared memory) sees the same files. JavaScript fills it at
+//! start (`std::os::hzweb::put`) and drains changed paths into IndexedDB
+//! (`std::os::hzweb::take_change`). Paths are absolute, '/'-separated; relative paths are
+//! taken from the virtual current directory `/`.
+
+use crate::collections::{BTreeMap, BTreeSet};
+use crate::ffi::OsString;
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::{Hash, Hasher};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Component, Path, PathBuf};
+use crate::sync::{Arc, Mutex, RwLock};
+pub use crate::sys::fs::common::{Dir, ExtraHomeDirs, ExtraMediaDirs};
+use crate::sys::time::SystemTime;
+
+
+type Data = Arc<RwLock<Vec<u8>>>;
+
+#[derive(Clone)]
+enum Node {
+    Dir { mtime: SystemTime },
+    File { data: Data, mtime: SystemTime },
+}
+
+struct Vfs {
+    nodes: BTreeMap<String, Node>,
+    /// Paths changed since JS last drained them (written, created or removed).
+    changed: BTreeSet<String>,
+}
+
+static VFS: Mutex<Vfs> = Mutex::new(Vfs { nodes: BTreeMap::new(), changed: BTreeSet::new() });
+
+fn now() -> SystemTime {
+    SystemTime::now()
+}
+
+/// `/a/./b/../c` and `a/c` -> `/a/c`. The root is `/`.
+fn norm(p: &Path) -> String {
+    let mut parts: crate::vec::Vec<String> = crate::vec::Vec::new();
+    for c in p.components() {
+        match c {
+            Component::RootDir | Component::Prefix(_) | Component::CurDir => {}
+            Component::ParentDir => {
+                parts.pop();
+            }
+            Component::Normal(s) => parts.push(s.to_string_lossy().into_owned()),
+        }
+    }
+    let mut out = String::from("/");
+    out.push_str(&parts.join("/"));
+    out
+}
+
+fn parent(path: &str) -> Option<&str> {
+    if path == "/" {
+        return None;
+    }
+    match path.rfind('/') {
+        Some(0) => Some("/"),
+        Some(i) => Some(&path[..i]),
+        None => None,
+    }
+}
+
+fn not_found() -> io::Error {
+    io::const_error!(io::ErrorKind::NotFound, "No such file or directory")
+}
+fn exists_err() -> io::Error {
+    io::const_error!(io::ErrorKind::AlreadyExists, "File exists")
+}
+fn is_dir_err() -> io::Error {
+    io::const_error!(io::ErrorKind::IsADirectory, "Is a directory")
+}
+fn not_dir_err() -> io::Error {
+    io::const_error!(io::ErrorKind::NotADirectory, "Not a directory")
+}
+
+impl Vfs {
+    fn mkdirs(&mut self, path: &str) {
+        let mut cur = Some(path);
+        let mut todo = crate::vec::Vec::new();
+        while let Some(p) = cur {
+            if self.nodes.contains_key(p) {
+                break;
+            }
+            todo.push(p.to_string());
+            cur = parent(p);
+        }
+        for p in todo.into_iter().rev() {
+            self.nodes.insert(p.clone(), Node::Dir { mtime: now() });
+            self.changed.insert(p);
+        }
+    }
+    fn parent_is_dir(&self, path: &str) -> io::Result<()> {
+        match parent(path) {
+            None => Ok(()),
+            Some("/") => Ok(()),
+            Some(p) => match self.nodes.get(p) {
+                Some(Node::Dir { .. }) => Ok(()),
+                Some(Node::File { .. }) => Err(not_dir_err()),
+                None => Err(not_found()),
+            },
+        }
+    }
+    fn children(&self, dir: &str) -> crate::vec::Vec<String> {
+        let prefix = if dir == "/" { String::from("/") } else { format!("{dir}/") };
+        self.nodes
+            .range(prefix.clone()..)
+            .take_while(|(k, _)| k.starts_with(&prefix))
+            .filter(|(k, _)| !k[prefix.len()..].contains('/') && k.len() > prefix.len())
+            .map(|(k, _)| k.clone())
+            .collect()
+    }
+}
+
+// ---- hooks for std::os::hzweb ----
+
+/// Adds or replaces a file (parents are created); not reported back as a change.
+pub fn vfs_put(path: &Path, data: Vec<u8>, record: bool) {
+    let p = norm(path);
+    let mut v = VFS.lock().unwrap();
+    if let Some(par) = parent(&p) {
+        let par = par.to_string();
+        let before = v.changed.clone();
+        v.mkdirs(&par);
+        if !record {
+            v.changed = before;
+        }
+    }
+    v.nodes.insert(p.clone(), Node::File { data: Arc::new(RwLock::new(data)), mtime: now() });
+    if record {
+        v.changed.insert(p);
+    }
+}
+
+pub fn vfs_mkdirs(path: &Path) {
+    let p = norm(path);
+    let mut v = VFS.lock().unwrap();
+    let before = v.changed.clone();
+    v.mkdirs(&p);
+    v.changed = before;
+}
+
+/// One changed path: `(path, Some(bytes))` for a file, `(path, None)` for a removed path,
+/// and directories as `(path/, None)`... directories are reported with a trailing '/'
+/// and empty contents. `None` when nothing changed.
+pub fn vfs_take_change() -> Option<(String, Option<Vec<u8>>)> {
+    let mut v = VFS.lock().unwrap();
+    let p = v.changed.pop_first()?;
+    Some(match v.nodes.get(&p) {
+        Some(Node::File { data, .. }) => (p, Some(data.read().unwrap().clone())),
+        Some(Node::Dir { .. }) => (format!("{p}/"), Some(Vec::new())),
+        None => (p, None),
+    })
+}
+
+pub fn vfs_file_count() -> usize {
+    VFS.lock().unwrap().nodes.len()
+}
+
+// ---- std types ----
+
+pub struct File {
+    path: String,
+    data: Data,
+    pos: Mutex<u64>,
+    append: bool,
+    write: bool,
+    read: bool,
+}
+
+#[derive(Clone)]
+pub struct FileAttr {
+    size: u64,
+    kind: FileType,
+    mtime: SystemTime,
+}
+
+pub struct ReadDir {
+    root: PathBuf,
+    entries: crate::vec::IntoIter<String>,
+}
+
+pub struct DirEntry {
+    path: String,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {
+    modified: Option<SystemTime>,
+}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    dir: bool,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+impl FileAttr {
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { readonly: false }
+    }
+    pub fn file_type(&self) -> FileType {
+        self.kind
+    }
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(self.mtime)
+    }
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        Ok(self.mtime)
+    }
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Ok(self.mtime)
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.readonly
+    }
+    pub fn set_readonly(&mut self, readonly: bool) {
+        self.readonly = readonly
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, _t: SystemTime) {}
+    pub fn set_modified(&mut self, t: SystemTime) {
+        self.modified = Some(t)
+    }
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.dir
+    }
+    pub fn is_file(&self) -> bool {
+        !self.dir
+    }
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+}
+
+impl ReadDir {
+    pub fn dir(&self) -> io::Result<Dir> {
+        Err(io::Error::UNSUPPORTED_PLATFORM)
+    }
+}
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ReadDir").field("root", &self.root).finish()
+    }
+}
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        self.entries.next().map(|path| Ok(DirEntry { path }))
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        PathBuf::from(&self.path)
+    }
+    pub fn file_name(&self) -> OsString {
+        OsString::from(self.path.rsplit('/').next().unwrap_or(""))
+    }
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        stat(Path::new(&self.path))
+    }
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.metadata()?.kind)
+    }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
+    }
+    pub fn read(&mut self, v: bool) {
+        self.read = v
+    }
+    pub fn write(&mut self, v: bool) {
+        self.write = v
+    }
+    pub fn append(&mut self, v: bool) {
+        self.append = v
+    }
+    pub fn truncate(&mut self, v: bool) {
+        self.truncate = v
+    }
+    pub fn create(&mut self, v: bool) {
+        self.create = v
+    }
+    pub fn create_new(&mut self, v: bool) {
+        self.create_new = v
+    }
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let p = norm(path);
+        let writes = opts.write || opts.append;
+        let mut v = VFS.lock().unwrap();
+        let data = match v.nodes.get(&p) {
+            Some(Node::Dir { .. }) => {
+                if writes {
+                    return Err(is_dir_err());
+                }
+                // Reading a directory as a file: std allows opening it on unix.
+                Arc::new(RwLock::new(Vec::new()))
+            }
+            Some(Node::File { data, .. }) => {
+                let data = data.clone();
+                if opts.create_new {
+                    return Err(exists_err());
+                }
+                if opts.truncate && writes {
+                    data.write().unwrap().clear();
+                    v.changed.insert(p.clone());
+                }
+                data
+            }
+            None => {
+                if !(opts.create || opts.create_new) || !writes {
+                    return Err(not_found());
+                }
+                v.parent_is_dir(&p)?;
+                let data: Data = Arc::new(RwLock::new(Vec::new()));
+                v.nodes.insert(p.clone(), Node::File { data: data.clone(), mtime: now() });
+                v.changed.insert(p.clone());
+                data
+            }
+        };
+        Ok(File {
+            path: p,
+            data,
+            pos: Mutex::new(0),
+            append: opts.append,
+            write: writes,
+            read: opts.read || !writes,
+        })
+    }
+
+    fn touched(&self) {
+        let mut v = VFS.lock().unwrap();
+        if let Some(Node::File { mtime, .. }) = v.nodes.get_mut(&self.path) {
+            *mtime = now();
+        }
+        v.changed.insert(self.path.clone());
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        let size = self.data.read().unwrap().len() as u64;
+        let mtime = match VFS.lock().unwrap().nodes.get(&self.path) {
+            Some(Node::File { mtime, .. }) | Some(Node::Dir { mtime }) => *mtime,
+            None => now(),
+        };
+        Ok(FileAttr { size, kind: FileType { dir: false }, mtime })
+    }
+    pub fn fsync(&self) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn datasync(&self) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn lock(&self) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn lock_shared(&self) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+    pub fn unlock(&self) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        if !self.write {
+            return Err(io::const_error!(io::ErrorKind::PermissionDenied, "not opened for writing"));
+        }
+        self.data.write().unwrap().resize(size as usize, 0);
+        self.touched();
+        Ok(())
+    }
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        if !self.read {
+            return Err(io::const_error!(io::ErrorKind::PermissionDenied, "not opened for reading"));
+        }
+        let data = self.data.read().unwrap();
+        let mut pos = self.pos.lock().unwrap();
+        let start = (*pos as usize).min(data.len());
+        let n = buf.len().min(data.len() - start);
+        buf[..n].copy_from_slice(&data[start..start + n]);
+        *pos += n as u64;
+        Ok(n)
+    }
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        crate::io::default_read_vectored(|b| self.read(b), bufs)
+    }
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        crate::io::default_read_buf(|b| self.read(b), cursor)
+    }
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        if !self.write {
+            return Err(io::const_error!(io::ErrorKind::PermissionDenied, "not opened for writing"));
+        }
+        {
+            let mut data = self.data.write().unwrap();
+            let mut pos = self.pos.lock().unwrap();
+            if self.append {
+                *pos = data.len() as u64;
+            }
+            let start = *pos as usize;
+            if data.len() < start {
+                data.resize(start, 0);
+            }
+            let end = start + buf.len();
+            if data.len() < end {
+                data.resize(end, 0);
+            }
+            data[start..end].copy_from_slice(buf);
+            *pos = end as u64;
+        }
+        self.touched();
+        Ok(buf.len())
+    }
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        crate::io::default_write_vectored(|b| self.write(b), bufs)
+    }
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn seek(&self, to: SeekFrom) -> io::Result<u64> {
+        let len = self.data.read().unwrap().len() as i128;
+        let mut pos = self.pos.lock().unwrap();
+        let new = match to {
+            SeekFrom::Start(n) => n as i128,
+            SeekFrom::End(d) => len + d as i128,
+            SeekFrom::Current(d) => *pos as i128 + d as i128,
+        };
+        if new < 0 {
+            return Err(io::const_error!(io::ErrorKind::InvalidInput, "seek before start"));
+        }
+        *pos = new as u64;
+        Ok(*pos)
+    }
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(Ok(self.data.read().unwrap().len() as u64))
+    }
+    pub fn tell(&self) -> io::Result<u64> {
+        Ok(*self.pos.lock().unwrap())
+    }
+    pub fn duplicate(&self) -> io::Result<File> {
+        Ok(File {
+            path: self.path.clone(),
+            data: self.data.clone(),
+            pos: Mutex::new(*self.pos.lock().unwrap()),
+            append: self.append,
+            write: self.write,
+            read: self.read,
+        })
+    }
+    pub fn set_permissions(&self, _perm: FilePermissions) -> io::Result<()> {
+        Ok(())
+    }
+    pub fn set_times(&self, times: FileTimes) -> io::Result<()> {
+        set_times(Path::new(&self.path), times)
+    }
+}
+
+impl fmt::Debug for File {
